# ============================================
# CASEG2 - Variáveis de Ambiente
# Copie para .env e preencha os valores
# ============================================

# --- Backend (Fastify) ---
PORT=3050
HOST=127.0.0.1
NODE_ENV=development

# JWT
JWT_SECRET=sua-chave-secreta-aqui-mude-em-producao
JWT_REFRESH_SECRET=sua-chave-refresh-aqui-mude-em-producao

# Banco de dados (SQLite via libSQL)
DATABASE_URL=file:./data/app.db

# CORS (origens permitidas, separadas por vírgula)
CORS_ORIGIN=http://localhost:5173,http://localhost:80

# --- Frontend (Vite) ---
# NOTA: O frontend usa caminhos relativos (/api/) por padrão.
# Só defina VITE_API_URL se o backend estiver em outro domínio/porta
# e você NÃO estiver usando Nginx como proxy reverso.
# VITE_API_URL=http://SEU_IP:3050
